# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none of them may be secret.
# ─────────────────────────────────────────────────────────────

# Runtime connection used by the app. In production use the Supabase POOLED
# connection string (port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/food_erp"

# Direct connection used ONLY by Prisma migrations (Supabase port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/food_erp"

# Integration tests run against this database. It is wiped by the test setup.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/food_erp_test"

# Better Auth: long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# Public base URL of the app.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encrypts sensitive columns such as national ID numbers (32+ chars).
DATA_ENCRYPTION_KEY="change-me-to-another-long-random-string-32chars"

# First Owner account created by `npm run db:seed`.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="ChangeMe!2026"
SEED_OWNER_NAME="Restaurant Owner"
# Create demo staff users (manager/cashier/kitchen/rider) with the demo password.
SEED_DEMO_USERS="true"
SEED_DEMO_PASSWORD="Demo!2026pass"
# Load a realistic demo restaurant (menu, customers, suppliers, orders …) when the database is empty.
SEED_DEMO_DATA="true"
# Eight weeks of past demo orders for the dashboard and reports (only with SEED_DEMO_DATA).
SEED_DEMO_SALES="true"

# File storage: "local" (dev, saves to public/uploads) or "supabase".
STORAGE_DRIVER="local"
SUPABASE_URL=""
# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="public-assets"
SUPABASE_PRIVATE_BUCKET="private-docs"

# Protects /api/cron/* endpoints (Vercel Cron sends it as a Bearer token).
CRON_SECRET="change-me"

# ── Outgoing messages (all optional; without them messages are logged and skipped) ──
# E-mail via Resend (password resets, urgent alerts).
RESEND_API_KEY=""
EMAIL_FROM="Restaurant <no-reply@example.com>"
# SMS through any HTTP gateway that accepts POST JSON { to, from, message } with a Bearer key.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER=""
# WhatsApp Cloud API (Meta Business): access token and phone number ID.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Demo or staging deployment: tell search engines not to index the site.
SITE_NOINDEX="false"
