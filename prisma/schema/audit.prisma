// ─── Audit log and transactional outbox ─────────────────────────────────────

/// Append-only. UPDATE and DELETE are blocked by a database trigger.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  branchId       String?  @map("branch_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  /// Manager/owner who authorised the action via PIN override, if any.
  overrideUserId String?  @map("override_user_id") @db.Uuid
  action         String // e.g. settings.update, user.create, role.permissions.update
  module         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  userAgent      String?  @map("user_agent")
  terminalId     String?  @map("terminal_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?   @relation("AuditActor", fields: [userId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Events written in the same transaction as the business change and
/// dispatched after commit (realtime pings, notifications).
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, id])
  @@map("outbox_events")
}
