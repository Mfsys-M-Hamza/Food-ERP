// ─── Customers (CRM) and delivery zones ─────────────────────────────────────

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  /// Linked login account for online customers (Phase 5). Walk-in/phone customers have none.
  userId         String?   @unique @map("user_id") @db.Uuid
  name           String
  /// Normalised E.164, e.g. +923001234567
  phone          String?   @unique
  email          String?
  notes          String?
  isBlocked      Boolean   @default(false) @map("is_blocked")
  blockReason    String?   @map("block_reason")
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  totalOrders    Int       @default(0) @map("total_orders")
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  lastOrderAt    DateTime? @map("last_order_at") @db.Timestamptz(6)
  loyaltyPoints  Int       @default(0) @map("loyalty_points")
  /// When an online account was linked. Account pages show only orders/addresses after this
  /// moment until the phone number is verified (prevents reading someone else's history).
  linkedAt       DateTime? @map("linked_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses CustomerAddress[]
  orders    Order[]
  favorites CustomerFavorite[]

  @@index([name])
  @@index([lastOrderAt])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  label       String   @default("Home")
  addressLine String   @map("address_line")
  area        String?
  city        String?
  landmark    String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  mapUrl      String?  @map("map_url")
  zoneId      String?  @map("zone_id") @db.Uuid
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zone     DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_addresses")
}

model DeliveryZone {
  id              String    @id @default(uuid()) @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  name            String
  charge          Decimal   @db.Decimal(12, 2)
  minimumOrder    Decimal   @default(0) @map("minimum_order") @db.Decimal(12, 2)
  freeAbove       Decimal?  @map("free_above") @db.Decimal(12, 2)
  estimatedMinutes Int      @default(45) @map("estimated_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses  CustomerAddress[]
  deliveries Delivery[]

  @@index([branchId, isActive])
  @@map("delivery_zones")
}

model CustomerFavorite {
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@map("customer_favorites")
}
